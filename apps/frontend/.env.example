# Copiez ce fichier vers .env.local puis renseignez les valeurs.
# Ne commitez jamais les valeurs réelles : seul ce fichier d'exemple est versionné.
# Les variables ci-dessous sont documentées en détail dans le .env.example racine.

# Clé de chiffrement Payload (jetons et mots de passe).
# Générez-la avec : openssl rand -base64 32
PAYLOAD_SECRET=""

# Connexion PostgreSQL utilisée par Payload.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Supabase : mode « Session » (port 5432) obligatoire pour les migrations.
DATABASE_URI=""

# URL publique de l'application, utilisée par Payload pour les liens absolus.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Supabase (client navigateur), si vous utilisez le SDK côté front.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
